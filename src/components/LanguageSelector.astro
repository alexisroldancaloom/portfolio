<div
  id="lang-selector"
  class="fixed inset-0 z-[100] flex items-center justify-center bg-dark/90 backdrop-blur-sm transition-opacity duration-500 hidden"
>
  <div class="text-center px-6">
    <h2 class="text-white font-bold mb-2" style="font-size: clamp(22px, 4vw, 36px);">
      <span class="text-secondary">A</span>lexis
      <span class="text-secondary">R</span>oldán
    </h2>
    <p class="text-white/70 mb-10" style="font-size: clamp(14px, 2vw, 18px);">
      Select your language / Selecciona tu idioma
    </p>
    <div class="flex flex-col sm:flex-row gap-6 justify-center">
      <button
        id="lang-es"
        class="group relative px-10 py-5 border-2 border-secondary rounded-xl text-white font-bold transition-all duration-300 hover:bg-secondary hover:scale-105"
        style="font-size: clamp(16px, 2.5vw, 22px); min-width: 200px;"
      >
        <span class="block text-3xl mb-2">🇲🇽</span>
        Español
      </button>
      <button
        id="lang-en"
        class="group relative px-10 py-5 border-2 border-secondary rounded-xl text-white font-bold transition-all duration-300 hover:bg-secondary hover:scale-105"
        style="font-size: clamp(16px, 2.5vw, 22px); min-width: 200px;"
      >
        <span class="block text-3xl mb-2">🇺🇸</span>
        English
      </button>
    </div>
  </div>
</div>
