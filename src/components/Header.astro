<header
  class="fixed top-0 left-0 w-screen flex justify-between items-center py-4 px-4 md:px-8 lg:px-16 xl:px-32 bg-primary shadow-md z-50"
>
  <a href="#hero" class="text-medium font-bold text-secondary shrink-0" aria-label="Inicio">
    A<span class="text-dark">lexis</span> R<span class="text-dark">oldán</span>
  </a>

  <div class="block lg:hidden">
    <button id="menu-toggle" class="focus:outline-none" aria-label="Abrir menú de navegación" aria-expanded="false" aria-controls="menu">
      <svg
        class="w-8 h-8 text-secondary"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16m-7 6h7"></path>
      </svg>
    </button>
  </div>

  <nav
    id="menu"
    aria-label="Navegación principal"
    class="hidden lg:block absolute lg:static top-16 left-0 lg:top-auto lg:left-auto w-full lg:w-auto bg-primary lg:bg-transparent shadow-md lg:shadow-none"
  >
    <ul
      class="flex flex-col lg:flex-row items-center lg:space-x-6 space-y-4 lg:space-y-0 text-normal px-4 lg:px-0 py-4 lg:py-0"
    >
      <li>
        <a
          href="#about"
          data-i18n="nav.about"
          class="text-dark hover:text-secondary transition-colors duration-300 whitespace-nowrap"
          >¿Quién soy?</a
        >
      </li>
      <li>
        <a
          href="#experience"
          data-i18n="nav.experience"
          class="text-dark hover:text-secondary transition-colors duration-300 whitespace-nowrap"
          >Experiencia</a
        >
      </li>
      <li>
        <a
          href="#skills"
          data-i18n="nav.skills"
          class="text-dark hover:text-secondary transition-colors duration-300 whitespace-nowrap"
          >Skills</a
        >
      </li>
      <li>
        <a
          href="mailto:alexisroldandanemi@gmail.com"
          data-i18n="nav.contact"
          class="bg-secondary text-white px-4 py-2 rounded hover:bg-dark transition-colors duration-300 whitespace-nowrap"
          >¡Contáctame!</a
        >
      </li>
      <li>
        <button
          id="lang-toggle"
          class="text-dark hover:text-secondary transition-colors duration-300 font-bold border border-dark rounded px-3 py-1 text-sm"
          title="Cambiar idioma"
        >
          EN
        </button>
      </li>
    </ul>
  </nav>
</header>

<script>
  const menuToggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("menu");

  menuToggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    menuToggle.setAttribute("aria-expanded", String(isOpen));
  });
</script>
